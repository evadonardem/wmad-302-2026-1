
{
  "expo": {
    "name": "Marketplace Capstone",
    "slug": "10-marketplace-capstone",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "assetBundlePatterns": [
      "**/*"
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wmad302.marketplace"
    },

    "android": {
      "package": "com.wmad302.marketplace",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },

    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-font"
    ],

    "scheme": "marketplace",

    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1ab6e85b-eb22-4be8-9906-4b85ae582933"
      }
    }
  }
}
