
{
  "expo": {
    "name": "CartlyX",
    "slug": "10-marketplace-capstone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#004B18"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wmad302.marketplace"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#004B18"
      },
      "package": "com.wmad302.marketplace"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "marketplace",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "465da7f8-29f7-4218-a7c4-8246bcb523b9"
      }
    },
    "owner": "mavz8"
  }
}
